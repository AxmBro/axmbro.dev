# Copy to `.env` in the project root. All variables are optional.
# The site builds and runs without them; features below simply stay disabled.

# Contact form (Nodemailer) - email that sends and receives form submissions
# Gmail: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_USER=
SMTP_PASSWORD=

# YouTube Data API v3 - live subscriber/view counts in the home hero stats
# Google Cloud Console -> enable YouTube Data API v3 -> create API key
YOUTUBE_API_KEY=
